{
  "name": "@filens/design",
  "version": "0.1.1",
  "description": "CAD, diagram, mind-map, and 3D preview drivers for @filens.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@filens/cad": "^0.1.1",
    "@filens/diagram": "^0.1.1",
    "@filens/mindmap": "^0.1.1",
    "@filens/model3d": "^0.1.2"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.2"
  },
  "devDependencies": {
    "@filens/cad": "file:../cad",
    "@filens/core": "file:../core",
    "@filens/diagram": "file:../diagram",
    "@filens/mindmap": "file:../mindmap",
    "@filens/model3d": "file:../model3d"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orca-zhang/filens.git",
    "directory": "packages/design"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
