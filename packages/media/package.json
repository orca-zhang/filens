{
  "name": "@filens/media",
  "version": "0.1.3",
  "description": "Image, audio, video, and panorama preview drivers for @filens.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    },
    "./codecs": {
      "types": "./dist/codec-preview-driver.d.ts",
      "import": "./dist/codecs.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@filens/converter-client": "^0.1.3",
    "@filens/panorama": "^0.1.3"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.4"
  },
  "devDependencies": {
    "@filens/core": "file:../core",
    "@filens/panorama": "file:../panorama"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceWhaleTech/filens.git",
    "directory": "packages/media"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
