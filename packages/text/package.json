{
  "name": "@filens/text",
  "version": "0.1.2",
  "description": "Text, code, HTML, and ebook preview drivers for @filens.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@filens/books": "^0.1.1"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.3"
  },
  "devDependencies": {
    "@filens/core": "file:../core",
    "@filens/books": "file:../ebook"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orca-zhang/filens.git",
    "directory": "packages/text"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
