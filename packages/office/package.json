{
  "name": "@filens/office",
  "version": "0.1.2",
  "description": "Office, PDF, and iWork preview drivers for @filens.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@filens/docx": "^0.1.1",
    "@filens/iwork": "^0.1.2",
    "@filens/pdf": "^0.1.1",
    "@filens/xlsx": "^0.1.2"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.3"
  },
  "devDependencies": {
    "@filens/core": "file:../core",
    "@filens/docx": "file:../docx",
    "@filens/iwork": "file:../iwork",
    "@filens/pdf": "file:../pdf",
    "@filens/xlsx": "file:../xlsx"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceWhaleTech/filens.git",
    "directory": "packages/office"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
