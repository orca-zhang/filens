{
  "name": "@filens/core",
  "version": "0.1.6",
  "description": "Shared front-end preview runtime and PowerPoint compatibility API for modern ESM applications.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.css"
  ],
  "keywords": [
    "pptx",
    "powerpoint",
    "preview",
    "viewer",
    "esm",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./rendering": {
      "types": "./dist/rendering.d.ts",
      "import": "./dist/rendering.js"
    },
    "./archive-volumes": {
      "types": "./dist/archive-volumes.d.ts",
      "import": "./dist/archive-volumes.js"
    },
    "./zip": {
      "types": "./dist/zip.d.ts",
      "import": "./dist/zip.js"
    },
    "./preview-runtime": {
      "types": "./dist/preview-runtime.d.ts",
      "import": "./dist/preview-runtime.js"
    },
    "./presentation-support": {
      "types": "./dist/presentation-support.d.ts",
      "import": "./dist/presentation-support.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/rename-css.mjs ./dist style.css index.css",
    "dev": "vite build --watch",
    "test": "node ../../scripts/generate-fixtures.mjs && vitest run",
    "test:unit": "node ../../scripts/generate-fixtures.mjs && vitest run"
  },
  "dependencies": {
    "@filens/pptx": "^0.1.0",
    "@zip.js/zip.js": "^2.24.0",
    "cfb": "^1.2.2",
    "fflate": "^0.8.3",
    "jszip": "^3.10.1",
    "utif": "^3.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orca-zhang/filens.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
