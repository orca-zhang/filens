{
  "name": "@filens/xlsx",
  "version": "0.1.1",
  "description": "XLSX preview driver for the @filens multi-format preview runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.css"
  ],
  "keywords": [
    "xlsx",
    "excel",
    "spreadsheet",
    "preview",
    "viewer",
    "esm",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/rename-css.mjs ./dist style.css index.css",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.3"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.2"
  },
  "devDependencies": {
    "@filens/core": "file:../core",
    "jszip": "^3.10.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceWhaleTech/filens.git",
    "directory": "packages/xlsx"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
