{
  "name": "@filens/converter-client",
  "version": "0.1.3",
  "description": "Optional WASM, HTTP, and mock converter client adapters for @filens multi-format preview routes.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "keywords": [
    "conversion",
    "preview",
    "office",
    "adapter",
    "esm",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./format-detector": {
      "types": "./dist/format-detector-auto.d.ts",
      "import": "./dist/format-detector-auto.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/build-format-detector.mjs",
    "build": "vite build",
    "predev": "node ../../scripts/build-format-detector.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.3"
  },
  "devDependencies": {
    "@filens/core": "file:../core"
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceWhaleTech/filens.git",
    "directory": "packages/converter-client"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
