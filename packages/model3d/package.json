{
  "name": "@filens/model3d",
  "version": "0.1.2",
  "description": "Browser-native 3D model preview driver for the @filens multi-format preview runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.css"
  ],
  "keywords": [
    "3d",
    "stl",
    "model",
    "three",
    "preview",
    "viewer",
    "esm",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/rename-css.mjs ./dist style.css index.css",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "filens-step": "0.1.0-rc.1",
    "three": "^0.176.0",
    "@types/three": "^0.176.0"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.2"
  },
  "devDependencies": {
    "@filens/core": "file:../core",
    "occt-import-js": "0.0.23",
    "jszip": "^3.10.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orca-zhang/filens.git",
    "directory": "packages/model3d"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
