{
  "name": "@filens/archive",
  "version": "0.1.0",
  "description": "Read-only ZIP, RAR, 7z, TAR, and GZIP preview and extraction for the @filens runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.css"
  ],
  "keywords": [
    "archive",
    "zip",
    "rar",
    "7z",
    "tar",
    "gzip",
    "preview",
    "viewer",
    "esm",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/rename-css.mjs ./dist style.css index.css",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "jszip": "^3.10.1"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.0"
  },
  "devDependencies": {
    "7z-wasm": "^1.2.0",
    "@filens/core": "file:../core"
  }
}
