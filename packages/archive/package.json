{
  "name": "@filens/archive",
  "version": "0.1.2",
  "description": "Read-only archive preview: ZIP/ZIPX, RAR/7z, TAR, compressed streams, AR/DEB/CPIO/RPM, LHA/XAR, CAB/ISO/UDF and WIM/ESD for the @filens runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/index.css"
  ],
  "keywords": [
    "archive",
    "zip",
    "rar",
    "7z",
    "tar",
    "gzip",
    "preview",
    "viewer",
    "esm",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css",
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/rename-css.mjs ./dist style.css index.css",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "@filens/core": "^0.1.3"
  },
  "devDependencies": {
    "7z-wasm": "^1.2.0",
    "@filens/core": "file:../core",
    "jszip": "^3.10.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceWhaleTech/filens.git",
    "directory": "packages/archive"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
